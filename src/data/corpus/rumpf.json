        {
          "id": "ws-lumbago-proc",
          "titel": "Lumbago – Procedere",
          "typ": "procedere",
          "platzhalter": [],
          "segmente": [
            {
              "art": "text",
              "text": "Rückenschonendes Verhalten und Rückenschule empfohlen, keine körperliche Schonung. Bedarfsadaptierte Analgesie für eine Woche. Klinische Befundkontrolle bei einem niedergelassenen Kollegen. Bei Beschwerdepersistenz oder -progredienz ist eine weiterführende Diagnostik empfohlen. Sofortige Wiedervorstellung im nächstgelegenen Krankenhaus bei Neuauftreten akuter neurologischer Symptome (z. B. Lähmungserscheinungen, Sensibilitätsstörungen)."
            }
          ]
        },
        {
          "id": "ws-lws-prellung-proc",
          "titel": "LWS-Prellung – Procedere",
          "typ": "procedere",
          "platzhalter": [],
          "segmente": [
            {
              "art": "text",
              "text": "Maßnahmen in der ZNA: Untersuchung und Beratung, Analgesie, Handlungsanweisung für zunehmende Beschwerden. Empfehlungen: Befundkontrolle und Weiterbehandlung durch einen niedergelassenen Kollegen. Bei anhaltenden Beschwerden empfehlen wir weiterführende Diagnostik. Sofortige Wiedervorstellung im nächstgelegenen Krankenhaus bei akuten neurologischen Beschwerden."
            }
          ]
        }
