        {
          "id": "finger-skidaumen-proc",
          "titel": "Skidaumen – Procedere",
          "typ": "procedere",
          "platzhalter": [],
          "segmente": [
            {
              "art": "text",
              "text": "Zum Ausschluss einer Stener-Läsion ist eine MRT-Untersuchung des Daumens empfohlen; diese wurde durch uns angemeldet. Nach Durchführung bitten wir um Wiedervorstellung in unserer Sprechstunde zur Planung des weiteren Procedere. Bis dahin Ruhigstellung in Grundgelenks-Fixationsschiene und bedarfsgerechte Analgesie."
            }
          ]
        },
        {
          "id": "finger-nagelkranzfraktur-proc",
          "titel": "Nagelkranzfraktur – Procedere",
          "typ": "procedere",
          "platzhalter": [
            {
              "id": "finger-nagelkranz-ruhig",
              "typ": "zeitraum",
              "label": "Ruhigstellung Stack-Schiene",
              "einheit": "Wochen",
              "default": "2",
              "required": true
            }
          ],
          "segmente": [
            {
              "art": "text",
              "text": "Entlastung des subungualen Hämatoms unter sterilen Kautelen, steriler Wundverband, Anlage einer Stack-Schiene, Auffrischung des Tetanusschutzes. Regelmäßige Befundkontrollen beim niedergelassenen Durchgangsarzt / Kollegen, Kühlung, Schonung, Hochlagerung. Ruhigstellung mittels Stack-Schiene für "
            },
            {
              "art": "platzhalter",
              "ref": "finger-nagelkranz-ruhig"
            },
            {
              "art": "text",
              "text": ". Bei Befundverschlechterung sofortige Wiedervorstellung. Bei Beschwerdepersistenz ggf. weitere Diagnostik."
            }
          ]
        },
        {
          "id": "finger-panaritium-proc",
          "titel": "Panaritium – Untersuchung und Procedere",
          "typ": "procedere",
