{
  "name": "kitteltext",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministischer Textbaustein-Zusammensetzer fuer O&U-/ZNA-Doku. Keine Patientendaten.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-corpus.mjs",
    "build": "tsc --noEmit && vite build && vite build --config vite.pc.config.ts",
    "build:app": "vite build",
    "build:pc": "vite build --config vite.pc.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@preact/signals": "^2.0.1",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
