{
  "name": "kitteltext",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "Formulierungshilfe fuer Arztbriefe in Orthopaedie und Unfallchirurgie. Keine Patientendaten, keine Datenuebertragung.",
  "type": "module",
  "scripts": {
    "dev": "node tools/katalog-index.mjs && vite",
    "test": "node tools/katalog-index.mjs && node --test \"tests/*.test.ts\"",
    "test:e2e": "npm run build && playwright test",
    "validate": "node tools/katalog-index.mjs && node --test tests/katalog.test.ts",
    "build": "node tools/katalog-index.mjs && tsc --noEmit && vite build && vite build --config vite.einzeldatei.config.ts && node tools/einzeldatei-umbenennen.mjs",
    "preview": "vite preview",
    "index": "node tools/katalog-index.mjs",
    "status": "node tools/katalog-index.mjs && node tools/vorlagenstatus.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.0.1",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "^2.9.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
